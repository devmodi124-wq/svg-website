# Cloudflare's static-assets server sets Content-Type from a file's
# extension. /opengraph-image and /twitter-image are Next's file-convention
# routes (app/opengraph-image.tsx, app/twitter-image.tsx) — under
# `output: "export"` Next writes their PNG bytes to `out/` with no extension
# at all, because the framework's own Content-Type header is only wired up
# for its Node/edge server runtime, which a static export doesn't have.
# Confirmed locally: `curl -D-` against `wrangler dev` returns 200 with the
# correct bytes but no Content-Type header for these two paths, while an
# extensioned file like favicon.svg gets image/svg+xml automatically.
#
# Without this, WhatsApp, LinkedIn, Twitter/X and Slack link previews single
# out these two paths and either skip the image or refuse to render it,
# because their unfurlers require an image/* Content-Type, not just an
# image's actual bytes.
/opengraph-image
  Content-Type: image/png

/twitter-image
  Content-Type: image/png

# Every nested social preview (per-gas pages, /sahibabad-industrial-area/, any
# future page with an opengraph-image.tsx) is extensionless for the same
# reason. `*` matches across slashes, so one pair of rules covers them all.
/*/opengraph-image
  Content-Type: image/png

/*/twitter-image
  Content-Type: image/png

# ── Caching ─────────────────────────────────────────────────────────────────
# /_next/static/ filenames are content hashes, so a given URL never changes
# and can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# /images/ and the social previews keep stable filenames when replaced (see
# IMAGES.md), so they can't be immutable. A week, then revalidate in the
# background, means repeat visitors skip the download without a swapped
# photograph taking more than a week to appear.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ── Security ────────────────────────────────────────────────────────────────
# Applied to every response. No Content-Security-Policy on purpose: GA4 needs
# an inline init script and a policy loose enough to allow it adds little.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
